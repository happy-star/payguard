# Copy to .env in the repo root. Never commit .env.

# API port. The Vite dev server proxies /api here.
PORT=4317

# Where the browser UI lives in development (Vite).
CLIENT_ORIGIN=http://127.0.0.1:4318

# Public URL of this API. PayPal redirects the buyer here after approval.
# Use the API origin, not the Vite origin. For a single-port `npm start`, they are the same.
PUBLIC_BASE_URL=http://127.0.0.1:4317

# PayPal REST app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run the whole hold in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required for Sandbox webhook delivery. If this is empty while PayPal mode is sandbox,
# POST /api/paypal/webhook returns 503 and does not change any deal.
# Mock mode does not verify signatures and does not read this value.
PAYPAL_WEBHOOK_ID=
# Sandbox only. Do not point this at the live API for the hackathon demo.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# auto uses Sandbox when both PayPal keys are set, otherwise mock.
# mock forces the stand-in checkout even if keys are present.
# sandbox fails startup if the keys are missing.
PAYGUARD_PAYPAL=auto

# OpenAI-compatible chat completions. Works with OpenAI, Vultr Inference, Otari, and similar.
# OPENAI_BASE_URL must include the /v1 prefix if the provider uses one.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# auto uses the model when OPENAI_API_KEY is set, otherwise the built-in reader.
# mock forces the built-in reader. live fails startup if the key is missing.
PAYGUARD_AI=auto

# Optional override for the JSON deal file. Defaults to data/deals.json.
# PAYGUARD_DB=
